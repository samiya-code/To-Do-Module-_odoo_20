<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_todo_task_list" model="ir.ui.view">
        <field name="name">todo.task.list</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <list string="Tasks" decoration-danger="is_overdue or priority == '3'" decoration-success="state == 'completed'" decoration-warning="state == 'waiting'">
                <field name="name"/>
                <field name="assigned_user_id"/>
                <field name="state"/>
                <field name="priority" widget="priority"/>
                <field name="deadline"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="progress" widget="progressbar"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_todo_task_form" model="ir.ui.view">
        <field name="name">todo.task.form</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <form string="To-do Task">
                <header>
                    <button name="action_start" type="object" string="Start Task" class="btn-primary" invisible="state in ['in_progress', 'waiting', 'completed', 'cancelled']"/>
                    <button name="action_pause" type="object" string="Pause Task" class="btn-secondary" invisible="state not in ['in_progress']"/>
                    <button name="action_complete" type="object" string="Complete Task" class="btn-success" invisible="state in ['completed', 'cancelled']"/>
                    <button name="action_cancel" type="object" string="Cancel Task" class="btn-danger" invisible="state in ['cancelled']"/>
                    <button name="action_reopen" type="object" string="Reopen Task" class="btn-warning" invisible="state not in ['completed', 'cancelled']"/>
                    <button type="action" name="%(custom_todo.action_todo_task_report)d" string="Print Task" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,waiting,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Task name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="department"/>
                            <field name="priority" widget="priority"/>
                            <field name="deadline"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                        <group>
                            <field name="created_by_id"/>
                            <field name="start_date"/>
                            <field name="completion_date"/>
                            <field name="estimated_hours"/>
                            <field name="actual_hours"/>
                            <field name="company_id"/>
                            <field name="recurring_task"/>
                            <field name="recurrence_type" invisible="not recurring_task"/>
                            <field name="recurrence_interval" invisible="not recurring_task"/>
                            <field name="next_recurrence_date" invisible="not recurring_task"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe the task in detail..."/>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_todo_task_kanban" model="ir.ui.view">
        <field name="name">todo.task.kanban</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column o_todo_task_kanban" records_draggable="true">
                <field name="name"/>
                <field name="assigned_user_id"/>
                <field name="priority"/>
                <field name="deadline"/>
                <field name="tag_ids"/>
                <field name="progress"/>
                <field name="is_overdue"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click o_todo_task_card oe_kanban_color_#{kanban_getcolor(record.color.raw_value)}">
                            <div class="o_todo_task_card_top">
                                <div class="o_todo_task_card_title"><field name="name"/></div>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="o_todo_task_card_meta">
                                <div t-if="record.is_overdue.raw_value" class="o_todo_task_overdue">Overdue</div>
                                <div class="o_todo_task_assignee"><field name="assigned_user_id"/></div>
                                <div class="o_todo_task_deadline"><field name="deadline"/></div>
                                <div class="o_todo_task_tags"><field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/></div>
                            </div>
                            <div class="o_todo_task_progress">
                                <span>Progress</span>
                                <field name="progress" widget="progressbar"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_todo_task_calendar" model="ir.ui.view">
        <field name="name">todo.task.calendar</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <calendar string="Tasks" date_start="deadline" color="state" mode="month">
                <field name="name"/>
                <field name="assigned_user_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_todo_task_search" model="ir.ui.view">
        <field name="name">todo.task.search</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <search string="Search Tasks">
                <field name="name"/>
                <field name="assigned_user_id"/>
                <field name="department"/>
                <field name="tag_ids"/>
                <field name="company_id"/>
                <filter string="My Tasks" name="my_tasks" domain="[('assigned_user_id', '=', uid)]"/>
                <filter string="Overdue" name="overdue" domain="['&amp;', ('deadline', '&lt;', context_today()), ('state', 'not in', ['completed', 'cancelled'])]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="High Priority" name="high_priority" domain="[('priority', '=', '3')]"/>
                <separator/>
                <filter string="New" name="new_state" domain="[('state', '=', 'new')]"/>
                <filter string="In Progress" name="in_progress_state" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Waiting" name="waiting_state" domain="[('state', '=', 'waiting')]"/>
                <filter string="Cancelled" name="cancelled_state" domain="[('state', '=', 'cancelled')]"/>
                <group expand="1" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                    <filter string="Assigned User" name="group_assigned_user" context="{'group_by': 'assigned_user_id'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Tags" name="group_tags" context="{'group_by': 'tag_ids'}"/>
                    <filter string="Deadline" name="group_deadline" context="{'group_by': 'deadline'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Created By" name="group_created_by" context="{'group_by': 'created_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_todo_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">todo.task</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="search_view_id" ref="view_todo_task_search"/>
        <field name="context">{'search_default_my_tasks': 1}</field>
    </record>

    <record id="action_todo_all_tasks" model="ir.actions.act_window">
        <field name="name">All Tasks</field>
        <field name="res_model">todo.task</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="search_view_id" ref="view_todo_task_search"/>
        <field name="context">{'search_default_my_tasks': False}</field>
    </record>

    <record id="action_todo_calendar" model="ir.actions.act_window">
        <field name="name">Task Calendar</field>
        <field name="res_model">todo.task</field>
        <field name="view_mode">calendar,form</field>
        <field name="search_view_id" ref="view_todo_task_search"/>
        <field name="context">{'search_default_my_tasks': False}</field>
    </record>
</odoo>
