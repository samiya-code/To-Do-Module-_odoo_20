<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_todo_task_report" model="ir.actions.report">
        <field name="name">Task Report</field>
        <field name="model">todo.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_todo.report_todo_task_document</field>
        <field name="report_file">custom_todo.report_todo_task_document</field>
        <field name="binding_model_id" ref="model_todo_task"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Task - %s' % (object.name)</field>
    </record>

    <template id="report_todo_task_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span t-field="doc.name"/>
                        </h2>
                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr>
                                    <th>Assigned User</th>
                                    <td><span t-field="doc.assigned_user_id"/></td>
                                    <th>Status</th>
                                    <td><span t-field="doc.state"/></td>
                                </tr>
                                <tr>
                                    <th>Priority</th>
                                    <td><span t-field="doc.priority"/></td>
                                    <th>Deadline</th>
                                    <td><span t-field="doc.deadline"/></td>
                                </tr>
                                <tr>
                                    <th>Tags</th>
                                    <td><span t-field="doc.tag_ids"/></td>
                                    <th>Progress</th>
                                    <td><span t-field="doc.progress"/>%</td>
                                </tr>
                                <tr>
                                    <th>Created Date</th>
                                    <td><span t-field="doc.create_date"/></td>
                                    <th>Completion Date</th>
                                    <td><span t-field="doc.completion_date"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div>
                            <h4>Description</h4>
                            <p t-field="doc.description"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
