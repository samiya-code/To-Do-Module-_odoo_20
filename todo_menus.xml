<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="menu_todo_root" model="ir.ui.menu">
        <field name="name">Task Studio</field>
        <field name="sequence">30</field>
        <field name="web_icon">custom_todo,static/description/icon.png</field>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_todo_dashboard')"/>
        <field name="groups_id" eval="[(4, ref('base.group_system')), (4, ref('custom_todo.group_todo_user')), (4, ref('custom_todo.group_todo_manager'))]"/>
    </record>
    <record id="menu_todo_dashboard" model="ir.ui.menu">
        <field name="name">Dashboard</field>
        <field name="parent_id" ref="menu_todo_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_todo_dashboard')"/>
        <field name="sequence">1</field>
    </record>
    <record id="menu_todo_my_tasks" model="ir.ui.menu">
        <field name="name">My Tasks</field>
        <field name="parent_id" ref="menu_todo_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_todo_task')"/>
        <field name="sequence">2</field>
        <field name="web_icon" eval="False"/>
    </record>
    <record id="menu_todo_all_tasks" model="ir.ui.menu">
        <field name="name">All Tasks</field>
        <field name="parent_id" ref="menu_todo_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_todo_all_tasks')"/>
        <field name="sequence">3</field>
    </record>
    <record id="menu_todo_calendar" model="ir.ui.menu">
        <field name="name">Calendar</field>
        <field name="parent_id" ref="menu_todo_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_todo_calendar')"/>
        <field name="sequence">4</field>
    </record>
    <record id="menu_todo_tasks" model="ir.ui.menu">
        <field name="name">Tasks</field>
        <field name="parent_id" ref="menu_todo_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_todo_all_tasks')"/>
        <field name="sequence">5</field>
    </record>
    <record id="menu_todo_configuration" model="ir.ui.menu">
        <field name="name">Configuration</field>
        <field name="parent_id" ref="menu_todo_root"/>
        <field name="sequence">99</field>
        <field name="groups_id" eval="[(4, ref('base.group_system')), (4, ref('custom_todo.group_todo_manager'))]"/>
    </record>
    <record id="menu_todo_tags" model="ir.ui.menu">
        <field name="name">Tags</field>
        <field name="parent_id" ref="menu_todo_configuration"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_todo_tag')"/>
        <field name="sequence">10</field>
    </record>
</odoo>
