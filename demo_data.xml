<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="todo_tag_urgent" model="todo.tag">
        <field name="name">Urgent</field>
        <field name="color">2</field>
    </record>
    <record id="todo_tag_qa" model="todo.tag">
        <field name="name">QA</field>
        <field name="color">3</field>
    </record>
    <record id="todo_tag_sales" model="todo.tag">
        <field name="name">Sales</field>
        <field name="color">5</field>
    </record>

    <record id="todo_task_demo_1" model="todo.task">
        <field name="name">Prepare onboarding checklist</field>
        <field name="description">Review onboarding steps and assign tasks to the team.</field>
        <field name="assigned_user_id" ref="base.user_demo"/>
        <field name="created_by_id" ref="base.user_admin"/>
        <field name="department">Operations</field>
        <field name="priority">2</field>
        <field name="state">in_progress</field>
        <field name="deadline">2026-10-05</field>
        <field name="start_date">2026-10-02</field>
        <field name="progress">50</field>
        <field name="tag_ids" eval="[(6,0,[ref('todo_tag_urgent'), ref('todo_tag_qa')])]"/>
    </record>

    <record id="todo_task_demo_2" model="todo.task">
        <field name="name">Customer feedback review</field>
        <field name="description">Summarize customer feedback and recommend next actions.</field>
        <field name="assigned_user_id" ref="base.user_demo"/>
        <field name="created_by_id" ref="base.user_admin"/>
        <field name="department">Support</field>
        <field name="priority">3</field>
        <field name="state">waiting</field>
        <field name="deadline">2026-09-28</field>
        <field name="progress">50</field>
        <field name="tag_ids" eval="[(6,0,[ref('todo_tag_sales')])]"/>
    </record>

    <record id="todo_task_demo_3" model="todo.task">
        <field name="name">Quarterly review tasks</field>
        <field name="description">Finalize the management review for this quarter.</field>
        <field name="assigned_user_id" ref="base.user_admin"/>
        <field name="created_by_id" ref="base.user_admin"/>
        <field name="department">Management</field>
        <field name="priority">1</field>
        <field name="state">completed</field>
        <field name="deadline">2026-09-20</field>
        <field name="completion_date">2026-09-20</field>
        <field name="progress">100</field>
        <field name="tag_ids" eval="[(6,0,[ref('todo_tag_qa')])]"/>
    </record>
</odoo>
