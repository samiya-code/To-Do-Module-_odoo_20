<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_todo_task_assign_wizard_form" model="ir.ui.view">
        <field name="name">todo.task.assign.wizard.form</field>
        <field name="model">todo.task.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Task Assignment">
                <group>
                    <field name="assigned_user_id"/>
                    <field name="task_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Assign Tasks" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_todo_task_assign_wizard" model="ir.actions.act_window">
        <field name="name">Assign Tasks</field>
        <field name="res_model">todo.task.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_todo_task"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
